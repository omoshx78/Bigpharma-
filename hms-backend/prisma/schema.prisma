// DHS Pharmacy — multi-tenant inventory & point-of-sale schema.
// Every business ("Tenant") that signs up gets fully isolated data:
// its own users, inventory, sales, queue, expenses, and audit log.
// Every tenant-owned model carries a `tenantId` column, and every
// query in the app is expected to filter by it (see src/middleware/auth.ts
// and src/utils/tenantScope.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ORDER_TAKER
  CASHIER
}

enum Department {
  CASHIER
}

enum QueueStatus {
  WAITING
  CLAIMED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  INSURANCE
}

enum ClaimStatus {
  SUBMITTED
  APPROVED
  PARTIALLY_PAID
  PAID
  REJECTED
}

enum SaleStatus {
  CASHIER
  COMPLETED
  CANCELLED
}

// One row per pharmacy business. Created automatically the moment
// someone signs up — see POST /auth/signup.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Simple atomic counter used to generate human-friendly, per-tenant
  // sale numbers (SALE-1, SALE-2, ...) without a shared global sequence
  // leaking information between tenants (or contending under load).
  saleCounter Int @default(0)

  // --- Platform subscription billing (Flutterwave: card + M-Pesa) ---
  // currentPeriodEnd is the single source of truth for access: it's set
  // 14 days out at signup (free trial), and pushed forward one month by
  // each successful payment. Whether the tenant is ACTIVE, in its grace
  // window, or LOCKED is computed on the fly from this timestamp (see
  // src/middleware/subscriptionGate.ts) rather than stored, so there's
  // no background job required to "expire" anyone.
  currentPeriodEnd      DateTime  @default(dbgenerated("(now() + interval '30 days')"))
  subscriptionCanceledAt DateTime?

  // Optional per-tenant price override. Null means "use the platform
  // default" (SUBSCRIPTION_AMOUNT / SUBSCRIPTION_CURRENCY env vars).
  // Set via the set-tenant-price script — deliberately NOT exposed to
  // tenant admins through the app, since letting a pharmacy set its own
  // price would defeat the point.
  subscriptionAmount   Decimal? @db.Decimal(10, 2)
  subscriptionCurrency String?

  users                  User[]
  inventoryItems         InventoryItem[]
  inventoryTransactions  InventoryTransaction[]
  sales                  Sale[]
  saleItems              SaleItem[]
  billingItems           BillingItem[]
  payments               Payment[]
  claimPayments          ClaimPayment[]
  saleNotes              SaleNote[]
  queueEntries           QueueEntry[]
  expenses               Expense[]
  auditLogs              AuditLog[]
  subscriptionPayments   SubscriptionPayment[]
}

enum SubscriptionPaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

enum SubscriptionPaymentProvider {
  FLUTTERWAVE
  DARAJA
}

// --- Platform layer: sits ABOVE every tenant, completely separate from
// tenant auth (Tenant/User above). A PlatformAdmin is the SaaS owner
// (you), not a pharmacy — no tenantId, no relation to any Tenant. Its
// JWT has a distinct shape (see src/middleware/platformAuth.ts) so a
// tenant token and a platform token can never be confused for one
// another, even by a bug.
model PlatformAdmin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  expenses PlatformExpense[]
}

// The PLATFORM's own operating costs (hosting, payment processor fees,
// marketing, etc.) — NOT to be confused with Expense, which is a
// tenant's own pharmacy operating costs. Used for the super admin's net
// figures (platform subscription revenue minus these).
model PlatformExpense {
  id           String         @id @default(cuid())
  date         DateTime
  category     String
  amount       Decimal        @db.Decimal(10, 2)
  currency     String
  vendor       String?
  notes        String?
  recordedBy   PlatformAdmin? @relation(fields: [recordedById], references: [id])
  recordedById String?
  createdAt    DateTime       @default(now())

  @@index([date])
}

// A record of every platform subscription charge attempt (not to be
// confused with Payment, which is a pharmacy's own customer sale
// payment). One successful row here extends Tenant.currentPeriodEnd by
// one month. Covers two independent payment paths: Flutterwave (card +
// its own M-Pesa flow) and direct Safaricom Daraja STK Push (M-Pesa
// only, KES only) — see provider.
model SubscriptionPayment {
  id               String                      @id @default(cuid())
  tenant           Tenant                      @relation(fields: [tenantId], references: [id])
  tenantId         String
  provider         SubscriptionPaymentProvider @default(FLUTTERWAVE)
  txRef            String                      @unique
  amount           Decimal                     @db.Decimal(10, 2)
  currency         String
  status           SubscriptionPaymentStatus   @default(PENDING)
  paidAt           DateTime?
  periodStart      DateTime?
  periodEnd        DateTime?
  createdAt        DateTime                    @default(now())

  // Flutterwave-specific
  flwTransactionId String?

  // Daraja (M-Pesa STK Push) specific
  checkoutRequestId String? @unique
  merchantRequestId String?
  phoneNumber       String?
  mpesaReceiptNumber String?
  // If the tenant's real price (amount/currency above) isn't KES, this
  // is the converted amount actually charged via STK Push, and the rate
  // used to get there — kept for reconciliation/support, and used to
  // verify the M-Pesa payment instead of the tenant's original currency.
  kesAmount Decimal? @db.Decimal(10, 2)
  fxRate    Decimal? @db.Decimal(12, 6)

  @@index([tenantId, createdAt])
}

model User {
  id           String   @id @default(cuid())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  tenantId     String
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?

  claimedQueueEntries QueueEntry[] @relation("ClaimedBy")
  auditLogs           AuditLog[]

  @@index([tenantId, role])
}

model InventoryItem {
  id           String    @id @default(cuid())
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  tenantId     String
  name         String
  category     String    // Medicine | Consumable | Equipment
  unit         String
  quantity     Int       @default(0)
  reorderLevel Int       @default(0)
  unitPrice    Decimal   @db.Decimal(10, 2)
  expiryDate   DateTime?
  batchNo      String?
  createdAt    DateTime  @default(now())

  saleItems    SaleItem[]
  transactions InventoryTransaction[]

  @@index([tenantId, category])
}

model InventoryTransaction {
  id            String        @id @default(cuid())
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  tenantId      String
  item          InventoryItem @relation(fields: [itemId], references: [id])
  itemId        String
  changeQty     Int
  reason        String
  referenceType String?
  referenceId   String?
  createdById   String?
  createdAt     DateTime      @default(now())

  @@index([tenantId, itemId])
}

// One walk-in order/sale. Unlike the full DHS system, the order-taker both
// selects items AND dispenses them in a single step (no separate
// pharmacist hand-off) — so a sale is created already fulfilled, and goes
// straight into the shared Cashier queue for payment.
model Sale {
  id            String     @id @default(cuid())
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  tenantId      String
  saleNo        String
  customerName  String?
  customerPhone String?
  status        SaleStatus @default(CASHIER)
  createdById   String?
  createdAt     DateTime   @default(now())
  completedAt   DateTime?

  items        SaleItem[]
  billingItems BillingItem[]
  payment      Payment?
  queueEntries QueueEntry[]
  notes        SaleNote[]

  // Sale numbers are human-friendly and only need to be unique within a
  // tenant, not globally.
  @@unique([tenantId, saleNo])
  @@index([tenantId, createdAt])
}

model SaleItem {
  id       String        @id @default(cuid())
  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  tenantId String
  sale     Sale          @relation(fields: [saleId], references: [id])
  saleId   String
  item     InventoryItem @relation(fields: [itemId], references: [id])
  itemId   String
  quantity Int
  unitPrice Decimal      @db.Decimal(10, 2) // captured at time of sale, independent of later price changes

  @@index([tenantId, saleId])
}

model BillingItem {
  id          String   @id @default(cuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  sale        Sale     @relation(fields: [saleId], references: [id])
  saleId      String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  category    String?
  createdAt   DateTime @default(now())

  @@index([tenantId, saleId])
}

model Payment {
  id                String        @id @default(cuid())
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  tenantId          String
  sale              Sale          @relation(fields: [saleId], references: [id])
  saleId            String        @unique
  method            PaymentMethod
  amount            Decimal       @db.Decimal(10, 2)
  amountPaid        Decimal       @default(0) @db.Decimal(10, 2)
  insuranceProvider String?
  claimNo           String?
  claimStatus       ClaimStatus?
  claimSubmittedAt  DateTime?
  paidAt            DateTime?
  recordedById      String?

  installments ClaimPayment[]

  @@index([tenantId, method])
  @@index([tenantId, insuranceProvider])
}

model ClaimPayment {
  id           String   @id @default(cuid())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  tenantId     String
  payment      Payment  @relation(fields: [paymentId], references: [id])
  paymentId    String
  amount       Decimal  @db.Decimal(10, 2)
  recordedAt   DateTime @default(now())
  recordedById String?
  notes        String?

  @@index([tenantId, paymentId])
}

model SaleNote {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  sale      Sale     @relation(fields: [saleId], references: [id])
  saleId    String
  authorId  String?
  note      String
  createdAt DateTime @default(now())

  @@index([tenantId, saleId])
}

// Shared claim-based queue — currently only used for Cashier, but kept as
// its own model (rather than a flag on Sale) so a second department can
// be added later (e.g. splitting order-taking from dispensing) without a
// schema change.
model QueueEntry {
  id          String      @id @default(cuid())
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  tenantId    String
  sale        Sale        @relation(fields: [saleId], references: [id])
  saleId      String
  department  Department
  status      QueueStatus @default(WAITING)

  claimedBy   User?     @relation("ClaimedBy", fields: [claimedById], references: [id])
  claimedById String?
  claimedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId, department, status])
  @@index([tenantId, saleId, department])
}

model Expense {
  id           String   @id @default(cuid())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  tenantId     String
  date         DateTime
  category     String
  amount       Decimal  @db.Decimal(10, 2)
  vendor       String?
  notes        String?
  recordedById String?
  createdAt    DateTime @default(now())

  @@index([tenantId, date])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  tenantId   String
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
}
